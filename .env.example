# Bitrix REST API URL (скопируйте из вашего Bitrix)
VITE_BITRIX_REST_URL=https://your-site.ru/rest/USER_ID/ACCESS_KEY

# Filter / Mobile API URL
VITE_FILTER_API_URL=https://your-site.ru/mobile/v1

# DaData API token (https://dadata.ru — бесплатная регистрация)
VITE_DADATA_TOKEN=your_dadata_token_here

# Legacy: mock mode (true/false)
VITE_USE_MOCK_DATA=false
